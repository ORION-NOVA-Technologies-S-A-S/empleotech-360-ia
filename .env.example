# Copie este archivo como .env y cambie los valores
# ---- Base de datos ----
# Local (Docker):
DATABASE_URL=postgresql://empleotech:empleotech@db:5432/empleotech
POSTGRES_PASSWORD=empleotech
# Supabase (Project Settings → Database → Connection string → Transaction pooler):
# DATABASE_URL=postgresql://postgres.SU_PROYECTO:SU_CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ---- ORI SECURITY ----
# Genere una con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CAMBIAR-esta-clave-por-una-larga-y-aleatoria
JWT_MINUTOS=60
CORS_ORIGENES=http://localhost:8080,http://localhost:5173
LIMITE_PETICIONES_MINUTO=60

# ---- IA generativa (opcional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-sonnet-5-5

# ---- IoT por MQTT (opcional, perfil "iot") ----
MQTT_HOST=
MQTT_PORT=1883
MQTT_USUARIO=backend
MQTT_CLAVE=

# ---- Contacto ----
CONTACTO_WHATSAPP=573004440009
CONTACTO_TELEFONO=300 444 0009
